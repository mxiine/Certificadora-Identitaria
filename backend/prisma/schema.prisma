generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilUsuario {
  COORDENADOR
  VOLUNTARIO
}

enum StatusVoluntario {
  ATIVO
  INATIVO
}

model Usuario {
  id           String        @id @default(uuid())
  email        String        @unique
  senhaHash    String
  perfil       PerfilUsuario
  voluntario   Voluntario?   @relation(fields: [voluntarioId], references: [id])
  voluntarioId String?       @unique
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@map("usuarios")
}

model Voluntario {
  id                String           @id @default(uuid())
  nome              String
  curso             String
  contato           String
  dataEntrada       DateTime
  dataSaida         DateTime?
  status            StatusVoluntario @default(ATIVO)
  cargaHorariaTotal Float            @default(0)
  usuario           Usuario?
  vinculos          Vinculo[]
  criadoEm          DateTime         @default(now())
  atualizadoEm      DateTime         @updatedAt

  @@map("voluntarios")
}

enum PapelVinculo {
  TUTOR
  MONITOR
  APOIO
}

model Oficina {
  id           String        @id @default(uuid())
  tema         String
  descricao    String?
  data         DateTime      @db.Date
  horaInicio   String // formato HH:mm
  horas        Float
  local        String
  professor    String
  vinculos     Vinculo[]
  atendimentos Atendimento[]
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  @@map("oficinas")
}

model Vinculo {
  id           String       @id @default(uuid())
  oficinaId    String
  voluntarioId String
  papel        PapelVinculo
  horas        Float
  oficina      Oficina      @relation(fields: [oficinaId], references: [id], onDelete: Cascade)
  voluntario   Voluntario   @relation(fields: [voluntarioId], references: [id])
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  @@unique([oficinaId, voluntarioId])
  @@index([voluntarioId])
  @@map("vinculos")
}

model Atendimento {
  id          String   @id @default(uuid())
  oficinaId   String
  instituicao String
  quantidade  Int
  observacao  String?
  oficina     Oficina  @relation(fields: [oficinaId], references: [id], onDelete: Cascade)
  criadoEm    DateTime @default(now())

  @@index([oficinaId])
  @@map("atendimentos")
}