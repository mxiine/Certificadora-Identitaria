# Ambiente da aplicação (development | production | test)
NODE_ENV=development

# Porta em que a API NestJS vai rodar
PORT=3333

# String de conexão do PostgreSQL
# formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL=postgresql://trama:trama@localhost:5432/trama_db?schema=public

# Segredo usado para assinar os tokens JWT
JWT_SECRET=troque-este-valor-por-um-segredo-forte-aqui
JWT_EXPIRES_IN=7d

# URL do front-end (usada na configuração de CORS)
FRONTEND_URL=http://localhost:3000